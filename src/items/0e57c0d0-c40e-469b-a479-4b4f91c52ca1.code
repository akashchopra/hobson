export async function render(value, options, api) {
  if (!value) return api.createElement('div');

  const wrapper = api.createElement('div');
  wrapper.style.cssText = 'flex: 1; display: flex; flex-direction: column; min-height: 200px;';

  if (options.label) {
    const lbl = api.createElement('div');
    lbl.textContent = options.label;
    lbl.style.cssText = 'font-weight: 500; font-size: 0.875rem; color: var(--color-text); margin-bottom: 4px; flex-shrink: 0;';
    wrapper.appendChild(lbl);
  }

  const iframe = api.createElement('iframe');
  iframe.setAttribute('sandbox', 'allow-same-origin');
  iframe.srcdoc = value;
  iframe.style.cssText = 'width: 100%; border: 1px solid var(--color-border); border-radius: var(--border-radius); display: block; flex: 1; min-height: 200px;';
  iframe.onload = () => {
    try {
      const h = iframe.contentDocument?.documentElement?.scrollHeight;
      if (h) iframe.style.minHeight = (h + 32) + 'px';
    } catch (e) {}
  };
  wrapper.appendChild(iframe);
  return wrapper;
}
