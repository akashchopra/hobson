// Item: market-data
// ID: 6073171a-05a6-4467-979e-6442db58c39c
// Type: 66666666-0000-0000-0000-000000000000
//
// Fetches instrument prices from external sources.
// giltsyield.com for gilts; Yahoo Finance for ETFs.

const INSTRUMENT_TYPE_ID = '60ccdb32-566d-480b-8dae-ef1e4a5cdecc';
const PRICES_UPDATED_EVENT_ID = '7c41cb53-3ad5-4235-97f1-a3d6f3bf9b86';

function parseGiltsYieldPrice(html) {
  const match = html.match(/id="price"[^>]*value="([\d.]+)"/);
  if (!match) throw new Error('Dirty price not found in page');
  return { price: parseFloat(match[1]), date: null };
}

function parseYahooPrice(data) {
  const meta = data?.chart?.result?.[0]?.meta;
  const price = meta?.regularMarketPrice;
  if (price == null) throw new Error('Price not found in Yahoo Finance response');
  const currency = meta?.currency;
  const adjustedPrice = (currency === 'GBp' || currency === 'GBX') ? price / 100 : price;
  const date = meta?.regularMarketTime
    ? new Date(meta.regularMarketTime * 1000).toISOString().slice(0, 10)
    : null;
  return { price: adjustedPrice, date };
}

async function fetchPrice(instrument) {
  const type = instrument.content['instrument-type'];
  const sourceId = instrument.content['source-id'];
  const tauriFetch = window.__TAURI__.http.fetch;

  if (type === 'conventional_gilt' || type === 'index_linked_gilt') {
    const url = `https://giltsyield.com/bond/${encodeURIComponent(sourceId)}/`;
    const response = await tauriFetch(url, { method: 'GET' });
    if (!response.ok) throw new Error(`HTTP ${response.status}`);
    return parseGiltsYieldPrice(await response.text());
  } else if (type === 'etf') {
    const url = `https://query1.finance.yahoo.com/v8/finance/chart/${encodeURIComponent(sourceId)}`;
    const response = await tauriFetch(url);
    if (!response.ok) throw new Error(`HTTP ${response.status}`);
    return parseYahooPrice(await response.json());
  }
  throw new Error(`Unknown instrument-type: ${type}`);
}

export async function fetchAllPrices(api) {
  const allInstruments = await api.query({ type: INSTRUMENT_TYPE_ID });
  const instruments = allInstruments.filter(i => i.content['instrument-type'] !== 'cash');
  const today = new Date().toISOString().slice(0, 10);

  // Phase 1: fetch all prices before writing, so the canonical date is known
  const fetched = [];
  for (const instrument of instruments) {
    try {
      const { price, date } = await fetchPrice(instrument);
      fetched.push({ instrument, price, date, status: 'ok' });
    } catch (err) {
      fetched.push({ instrument, error: err?.message ?? String(err), status: 'error' });
    }
  }

  const sourceDate = fetched.find(r => r.date)?.date ?? today;

  // Phase 2: write, using sourceDate as fallback for instruments with no date (e.g. gilts)
  const results = [];
  for (const { instrument, price, date, error, status } of fetched) {
    if (status === 'ok') {
      instrument.content['last-price'] = price;
      instrument.content['last-price-date'] = date ?? sourceDate;
      instrument.modified = Date.now();
      await api.update(instrument);
      results.push({ id: instrument.id, name: instrument.name, price, status: 'ok' });
    } else {
      results.push({ id: instrument.id, name: instrument.name, error, status: 'error' });
    }
  }

  const timestamp = new Date(sourceDate).getTime() + 86400000 - 1;
  api.events.emit({ type: PRICES_UPDATED_EVENT_ID, content: { results, timestamp } });
  return results;
}
