    "code": "(defn render [item api]\n  (def search item)\n  (def target-container (get-in search [:content :target_container]))\n  (def attachments (or (:attachments search) []))\n  (def starred-ids (or (get-in search [:content :starredIds]) []))\n  (def recent-ids (or (get-in search [:content :recentIds]) []))\n  (def default-view-id \"d4e5f6a7-b8c9-4d0e-a1b2-c3d4e5f6a7b8\")\n  (def saved-ast (get-in search [:content :currentAst]))\n  (def is-default (nil? saved-ast))\n  (def default-ast (parse-hob! \"(->> (get-all) (sort-by :modified) reverse)\"))\n  (def pending-ast (atom (or saved-ast default-ast)))\n  (def error-msg (atom nil))\n\n  (def struct-ed (require \"field-view-hob-structural\"))\n  (def editor-el\n    (.render struct-ed\n      (deref pending-ast)\n      {:compact true\n       :onChange (fn [new-ast]\n                   (reset! pending-ast new-ast))\n       :onSubmit (fn [ast]\n                   (reset! error-msg nil)\n                   (try\n                     (let [matches (eval-hob-ast! ast)\n                           new-atts (vec (map (fn [m] {:id (:id m)}) matches))\n                           fresh (get-item (:id item))]\n                       (set-item!\n                         (->\n                           fresh\n                           (assoc :attachments new-atts)\n                           (assoc-in [:content :currentAst] ast)\n                           (assoc :modified (now)))))\n                     (catch e\n                       (reset! error-msg (str e))\n                       (rerender!))))}\n      api))\n\n  (defn render-group [ids]\n    (for [id ids]\n      [:render-child {:item id\n                      :view default-view-id\n                      :open-in (or target-container (get-parent-id))\n                      :data-sort-key id}]))\n\n  [:div.item-search-view {:style \"width: 100%; max-width: 800px; margin: 0 auto; padding: 20px; box-sizing: border-box;\"}\n\n    [:div {:style \"margin-bottom: 20px; padding-bottom: 15px; border-bottom: 2px solid var(--color-border-light);\"}\n      [:h2 {:style \"margin: 0; font-size: 1.25rem;\"}\n        (or (:name search) \"Search\")]]\n\n    [:div {:style \"margin-bottom: 4px;\"}\n      editor-el]\n\n    [:div {:style \"margin-bottom: 16px; font-size: 0.75rem; color: var(--color-text-secondary);\"}\n      \"Ctrl+Enter to search  ·  Use ->> pipeline: (get-all), filter, sort-by, reverse, take\"]\n\n    (when (deref error-msg)\n      [:div {:style \"margin-bottom: 16px; padding: 10px 14px; border: 1px solid var(--color-error, #c00); border-radius: var(--border-radius); color: var(--color-error, #c00); font-family: monospace; font-size: 0.875rem; white-space: pre-wrap;\"}\n        (deref error-msg)])\n\n    (if\n      is-default\n      [:div\n        (when (seq recent-ids)\n          [:details {:open true :style \"margin-bottom: 12px;\"}\n            [:summary {:style \"font-size: 0.875rem; color: var(--color-text-secondary); font-weight: 500; cursor: pointer; padding: 4px 0; margin-bottom: 8px;\"}\n              \"Recent\"]\n            (render-group recent-ids)])\n        (when (seq starred-ids)\n          [:details {:open true :style \"margin-bottom: 12px;\"}\n            [:summary {:style \"font-size: 0.875rem; color: var(--color-text-secondary); font-weight: 500; cursor: pointer; list-style: none; padding: 4px 0; margin-bottom: 8px;\"}\n              \"★ Starred\"]\n            (render-group starred-ids)])\n        (when (and (empty? starred-ids) (empty? recent-ids))\n          [:div {:style \"padding: 40px; text-align: center; color: var(--color-border-dark); font-style: italic;\"}\n            \"Press Ctrl+Enter to run the query\"])]\n      (if\n        (empty? attachments)\n        [:div {:style \"text-align: center; padding: 40px;\"}\n          [:div {:style \"color: var(--color-text-secondary);\"} \"No items found\"]]\n        [:div\n          [:div {:style \"margin-bottom: 15px; font-size: 0.875rem; color: var(--color-text-secondary); font-weight: 500;\"}\n            (str \"Found \" (count attachments) \" item\" (if (= (count attachments) 1) \"\" \"s\"))]\n          (for [att attachments]\n            (let [child-id (if (map? att) (:id att) att)\n                  view-id (or (get-in att [:view :type]) default-view-id)]\n              [:render-child {:item child-id\n                              :view view-id\n                              :open-in (or target-container (get-parent-id))\n                              :data-sort-key child-id}]))]\n    ))\n  ]\n)"
