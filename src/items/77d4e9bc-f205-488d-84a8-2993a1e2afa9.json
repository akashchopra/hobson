  "content": {
    "description": [
      ":doc",
      [
        ":p",
        {
          "s": "An investment portfolio: a named collection of "
        },
        [
          ":item-ref",
          {
            "s": "60ccdb32-566d-480b-8dae-ef1e4a5cdecc"
          },
          {
            "s": "instrument"
          }
        ],
        {
          "s": " holdings. Holding values and total value are computed reactively from instrument prices."
        }
      ],
      [
        ":h2",
        {
          "s": "Fields"
        }
      ],
      [
        ":ul",
        [
          ":li",
          [
            ":p",
            [
              ":code",
              {
                "s": "positions"
              }
            ],
            {
              "s": " \u2014 array of "
            },
            [
              ":code",
              {
                "s": "{ instrument-id, units }"
              }
            ],
            {
              "s": " objects. "
            },
            [
              ":code",
              {
                "s": "instrument-id"
              }
            ],
            {
              "s": " is the GUID of an instrument item; "
            },
            [
              ":code",
              {
                "s": "units"
              }
            ],
            {
              "s": " is the number of units held (for gilts, 1 unit = \u00a3100 nominal)."
            }
          ]
        ],
        [
          ":li",
          [
            ":p",
            [
              ":code",
              {
                "s": "computed.total-value"
              }
            ],
            {
              "s": " \u2014 Hob expression that maps over "
            },
            [
              ":code",
              {
                "s": "positions"
              }
            ],
            {
              "s": ", looks up "
            },
            [
              ":code",
              {
                "s": "last-price"
              }
            ],
            {
              "s": " from each instrument item, and sums "
            },
            [
              ":code",
              {
                "s": "last-price \u00d7 units"
              }
            ],
            {
              "s": "."
            }
          ]
        ]
      ]
    ],
