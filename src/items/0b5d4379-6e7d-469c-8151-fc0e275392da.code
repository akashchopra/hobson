(defn render [item api]
  (def task-type-id "0a41387e-78a9-4722-ab18-92aa14799385")
  (def attachments (or (:attachments item) []))
  (def doc (dom-get (hiccup->dom [:span]) :ownerDocument))
  (def new-name-atom (atom ""))
  (defn open-editable! [e]
    (let [ctx-lib (require "context-menu-lib")
          edit-view (.findEditableView ctx-lib api (:type item))
          parent-id (get-parent-id)]
      (when
        edit-view
        (if
          parent-id
          (.setAttachmentView api parent-id (:id item) (:id edit-view))
          (.setRootView api (:id edit-view))))))
  (defn toggle-status! [target-id]
    (let [fresh (get-item target-id)
          current (or (get-in fresh [:content :status]) "todo")
          new-status (if (= current "done") "todo" "done")]
      (set-item!
        (->
          fresh
          (assoc-in [:content :status] new-status)
          (assoc :modified (now))))))
  (defn add-subtask! [name]
    (when
      (seq (str name))
      (let [new-id (js/crypto.randomUUID)]
        (set-item!
          {:id new-id
           :name (str name)
           :type task-type-id
           :created (now)
           :modified (now)
           :content {:status "todo"}
           :attachments []})
        (attach! (:id item) new-id)
        (reset! new-name-atom ""))))
  (def doc-mod (require "field-view-doc-readonly"))
  (def
    desc-el
    (.render
      doc-mod
      (get-in item [:content :description])
      {:mode "readonly"}
      api))
  (def status (or (get-in item [:content :status]) "todo"))
  (def is-done (= status "done"))
  [:div {:style "padding: 12px 0; font-family: inherit;"}
    [:div {:id (str "task-header-" (:id item))
           :style "display: flex; align-items: center; gap: 10px; margin-bottom: 8px;"}
      [:input {:type "checkbox"
               :checked is-done
               :style "width: 16px; height: 16px; cursor: pointer; flex-shrink: 0; accent-color: var(--color-primary);"
               :on-change (fn [e] (toggle-status! (:id item)))}]
      [:span {:style (str
                       "font-size: 1.1em; font-weight: 600; flex: 1; "
                       (if
                         is-done
                         "text-decoration: line-through; color: var(--color-text-secondary);"
                         ""))
              :on-click (fn [e] (open-item! e (:id item)))}
        (or (:name item) "Untitled")]
      [:span {:style "font-size: 0.75em; color: var(--color-text-secondary); cursor: pointer; padding: 2px 8px; border: 1px solid var(--color-border-light); border-radius: var(--border-radius);"
              :on-click (fn [e] (open-editable! e))}
        "Edit"]]
    (when
      (get-in item [:content :description])
      [:div {:style "margin-bottom: 12px; padding-left: 26px; font-size: 0.9em; color: var(--color-text-secondary);"}

        desc-el])
    (when
      (seq attachments)
      [:div {:style "padding-left: 26px; margin-bottom: 8px;"}
        (for [att (seq attachments)]
          (let [child-id (if (map? att) (:id att) att)
                child (get-item child-id)
                child-done (=
                             (or (get-in child [:content :status]) "todo")
                             "done")
                panel-id (str "task-panel-" child-id)
                toggle-id (str "task-toggle-" child-id)]
            [:div {:style "border-left: 2px solid var(--color-border-light); margin-left: 4px; margin-bottom: 2px;"}

              [:div {:style "display: flex; align-items: center; gap: 8px; padding: 4px 8px;"}

                [:span {:id toggle-id
                        :style "font-size: 0.65em; color: var(--color-text-secondary); cursor: pointer; user-select: none; width: 14px; text-align: center; flex-shrink: 0;"
                        :on-click (fn [e]
                                    (let [panel (.getElementById doc panel-id)
                                          tog (.getElementById doc toggle-id)
                                          name-el (.getElementById
                                                    doc
                                                    (str
                                                      "task-child-name-"
                                                      child-id))
                                          open (=
                                                 (dom-get
                                                   (dom-get panel :style)
                                                   :display)
                                                 "block")]
                                      (dom-set!
                                        (dom-get panel :style)
                                        :display
                                        (if open "none" "block"))
                                      (dom-set!
                                        (dom-get
                                          (.getElementById
                                            doc
                                            (str "task-child-check-" child-id))
                                          :style)
                                        :display
                                        (if open "inline-block" "none"))
                                      (dom-set!
                                        (dom-get name-el :style)
                                        :display
                                        (if open "inline" "none"))
                                      (dom-set!
                                        tog
                                        :textContent
                                        (if open "▶" "▼"))))}
                  "▶"]
                [:input {:id (str "task-child-check-" child-id)
                         :type "checkbox"
                         :checked child-done
                         :style "width: 14px; height: 14px; cursor: pointer; flex-shrink: 0; accent-color: var(--color-primary);"
                         :on-change (fn [e] (toggle-status! child-id))}]
                [:span {:id (str "task-child-name-" child-id)
                        :style (str
                                 "flex: 1; font-size: 0.9em; cursor: pointer; "
                                 (if
                                   child-done
                                   "text-decoration: line-through; color: var(--color-text-secondary);"
                                   ""))
                        :on-click (fn [e] (open-item! e child-id))}
                  (or (:name child) "Untitled")]]
              [:div {:id panel-id
                     :style "display: none; padding-left: 20px; border-top: 1px solid var(--color-border-light);"}
                [:render-child {:item child-id
                                :view "0b5d4379-6e7d-469c-8151-fc0e275392da"
                                :open-in (get-parent-id)}]]]))])
    [:div {:style "display: flex; gap: 8px; align-items: center; padding-left: 26px;"}

      [:input {:type "text"
               :value (deref new-name-atom)
               :placeholder "New subtask..."
               :style "flex: 1; padding: 4px 8px; border: 1px solid var(--color-border-light); border-radius: var(--border-radius); font-family: inherit; font-size: 0.85em; background: var(--color-bg-surface-alt);"
               :on-input (fn [e]
                           (reset!
                             new-name-atom
                             (dom-get (dom-get e :target) :value)))
               :on-keydown (fn [e]
                             (when
                               (= (dom-get e :key) "Enter")
                               (add-subtask! (deref new-name-atom))))}]
      [:button {:style "padding: 4px 10px; background: none; border: 1px solid var(--color-border-light); border-radius: var(--border-radius); cursor: pointer; font-size: 0.8em; color: var(--color-primary); white-space: nowrap;"
                :on-click (fn [e] (add-subtask! (deref new-name-atom)))}
        "+ Add"]]])