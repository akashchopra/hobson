      [
        ":h2",
        {
          "s": "Exports"
        }
      ],
      [
        ":ul",
        [
          ":li",
          [
            ":p",
            [
              ":code",
              {
                "s": "fetchAllPrices(api)"
              }
            ],
            {
              "s": " — queries all instrument items, fetches a price for each, updates "
            },
            [
              ":code",
              {
                "s": "last-price"
              }
            ],
            {
              "s": " and "
            },
            [
              ":code",
              {
                "s": "last-price-date"
              }
            ],
            {
              "s": ". Returns an array of "
            },
            [
              ":code",
              {
                "s": "{ id, name, price, status }"
              }
            ],
            {
              "s": " (status is "
            },
            [
              ":code",
              {
                "s": "'ok'"
              }
            ],
            {
              "s": " or "
            },
            [
              ":code",
              {
                "s": "'error'"
              }
            ],
            {
              "s": "; errors include an "
            },
            [
              ":code",
              {
                "s": "error"
              }
            ],
            {
              "s": " field with the message)."
            }
          ]
        ]
      ]
    ],
    "code": "// Item: market-data\n// ID: 6073171a-05a6-4467-979e-6442db58c39c\n// Type: 66666666-0000-0000-0000-000000000000\n//\n// Fetches instrument prices from external sources.\n// giltsyield.com for gilts; Yahoo Finance for ETFs.\n\nconst INSTRUMENT_TYPE_ID = '60ccdb32-566d-480b-8dae-ef1e4a5cdecc';\nconst PRICES_UPDATED_EVENT_ID = '7c41cb53-3ad5-4235-97f1-a3d6f3bf9b86';\n\nfunction parseGiltsYieldPrice(html) {\n  const match = html.match(/id=\"price\"[^>]*value=\"([\\d.]+)\"/);\n  if (!match) throw new Error('Dirty price not found in page');\n  return { price: parseFloat(match[1]), date: null };\n}\n\nfunction parseYahooPrice(data) {\n  const meta = data?.chart?.result?.[0]?.meta;\n  const price = meta?.regularMarketPrice;\n  if (price == null) throw new Error('Price not found in Yahoo Finance response');\n  const currency = meta?.currency;\n  const adjustedPrice = (currency === 'GBp' || currency === 'GBX') ? price / 100 : price;\n  const date = meta?.regularMarketTime\n    ? new Date(meta.regularMarketTime * 1000).toISOString().slice(0, 10)\n    : null;\n  return { price: adjustedPrice, date };\n}\n\nasync function fetchPrice(instrument) {\n  const type = instrument.content['instrument-type'];\n  const sourceId = instrument.content['source-id'];\n  const tauriFetch = window.__TAURI__.http.fetch;\n\n  if (type === 'conventional_gilt' || type === 'index_linked_gilt') {\n    const url = `https://giltsyield.com/bond/${encodeURIComponent(sourceId)}/`;\n    const response = await tauriFetch(url, { method: 'GET' });\n    if (!response.ok) throw new Error(`HTTP ${response.status}`);\n    return parseGiltsYieldPrice(await response.text());\n  } else if (type === 'etf') {\n    const url = `https://query1.finance.yahoo.com/v8/finance/chart/${encodeURIComponent(sourceId)}`;\n    const response = await tauriFetch(url);\n    if (!response.ok) throw new Error(`HTTP ${response.status}`);\n    return parseYahooPrice(await response.json());\n  }\n  throw new Error(`Unknown instrument-type: ${type}`);\n}\n\nexport async function fetchAllPrices(api) {\n  const allInstruments = await api.query({ type: INSTRUMENT_TYPE_ID });\n  const instruments = allInstruments.filter(i => i.content['instrument-type'] !== 'cash');\n  const today = new Date().toISOString().slice(0, 10);\n\n  // Phase 1: fetch all prices before writing, so the canonical date is known\n  const fetched = [];\n  for (const instrument of instruments) {\n    try {\n      const { price, date } = await fetchPrice(instrument);\n      fetched.push({ instrument, price, date, status: 'ok' });\n    } catch (err) {\n      fetched.push({ instrument, error: err?.message ?? String(err), status: 'error' });\n    }\n  }\n\n  const sourceDates = fetched.filter(r => r.status === 'ok' && r.date).map(r => r.date);\n  const sourceDate = sourceDates.length > 0 ? sourceDates.sort().at(-1) : today;\n\n  // Phase 2: write, using sourceDate as fallback for instruments with no date (e.g. gilts)\n  const results = [];\n  for (const { instrument, price, date, error, status } of fetched) {\n    if (status === 'ok') {\n      instrument.content['last-price'] = price;\n      instrument.content['last-price-date'] = date ?? sourceDate;\n      instrument.modified = Date.now();\n      await api.update(instrument);\n      results.push({ id: instrument.id, name: instrument.name, price, status: 'ok' });\n    } else {\n      results.push({ id: instrument.id, name: instrument.name, error, status: 'error' });\n    }\n  }\n\n  const timestamp = new Date(sourceDate).getTime() + 86400000 - 1;\n  api.events.emit({ type: PRICES_UPDATED_EVENT_ID, content: { results, timestamp } });\n  return results;\n}\n",
