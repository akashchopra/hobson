    "code": "// Item: market-data\n// ID: 6073171a-05a6-4467-979e-6442db58c39c\n// Type: 66666666-0000-0000-0000-000000000000\n//\n// Fetches instrument prices from external sources.\n// giltsyield.com for gilts; Yahoo Finance for ETFs.\n\nconst INSTRUMENT_TYPE_ID = '60ccdb32-566d-480b-8dae-ef1e4a5cdecc';\n\nfunction parseGiltsYieldPrice(html) {\n  const match = html.match(/id=\"price\"[^>]*value=\"([\\d.]+)\"/);\n  if (!match) throw new Error('Dirty price not found in page');\n  return parseFloat(match[1]);\n}\n\nfunction parseYahooPrice(data) {\n  const meta = data?.chart?.result?.[0]?.meta;\n  const price = meta?.regularMarketPrice;\n  if (price == null) throw new Error('Price not found in Yahoo Finance response');\n  const currency = meta?.currency;\n  return (currency === 'GBp' || currency === 'GBX') ? price / 100 : price;\n}\n\nasync function fetchPrice(instrument) {\n  const type = instrument.content['instrument-type'];\n  const sourceId = instrument.content['source-id'];\n  const tauriFetch = window.__TAURI__.http.fetch;\n\n  if (type === 'conventional_gilt' || type === 'index_linked_gilt') {\n    const url = `https://giltsyield.com/bond/${encodeURIComponent(sourceId)}/`;\n    const response = await tauriFetch(url, { method: 'GET' });\n    if (!response.ok) throw new Error(`HTTP ${response.status}`);\n    return parseGiltsYieldPrice(await response.text());\n  } else if (type === 'etf') {\n    const url = `https://query1.finance.yahoo.com/v8/finance/chart/${encodeURIComponent(sourceId)}`;\n    const response = await tauriFetch(url);\n    if (!response.ok) throw new Error(`HTTP ${response.status}`);\n    return parseYahooPrice(await response.json());\n  }\n  throw new Error(`Unknown instrument-type: ${type}`);\n}\n\nexport async function fetchAllPrices(api) {\n  const allInstruments = await api.query({ type: INSTRUMENT_TYPE_ID });\n  const instruments = allInstruments.filter(i => i.content['instrument-type'] !== 'cash');\n  const date = new Date().toISOString().slice(0, 10);\n  const results = [];\n  for (const instrument of instruments) {\n    try {\n      const price = await fetchPrice(instrument);\n      instrument.content['last-price'] = price;\n      instrument.content['last-price-date'] = date;\n      instrument.modified = Date.now();\n      await api.update(instrument);\n      results.push({ id: instrument.id, name: instrument.name, price, status: 'ok' });\n    } catch (err) {\n      results.push({ id: instrument.id, name: instrument.name, error: err?.message ?? String(err), status: 'error' });\n    }\n  }\n  return results;\n}\n",
