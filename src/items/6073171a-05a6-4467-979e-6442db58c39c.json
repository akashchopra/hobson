          }
        ],
        {
          "s": " items and writes back "
        },
        [
          ":code",
          {
            "s": "last-price"
          }
        ],
        {
          "s": " and "
        },
        [
          ":code",
          {
            "s": "last-price-date"
          }
        ],
        {
          "s": ". Uses dividenddata.co.uk for gilts and Yahoo Finance for ETFs. All requests go via "
        },
        [
          ":code",
          {
            "s": "window.__TAURI__.http.fetch"
          }
        ],
        {
          "s": " to bypass CORS."
        }
