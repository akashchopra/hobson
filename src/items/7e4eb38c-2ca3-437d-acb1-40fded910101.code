
export function render(value, options, api) {
  const { mode, onChange, label, options: choices = [] } = options;
  const wrapper = api.createElement('div', { className: 'field-dropdown' });
  wrapper.style.cssText = 'display: flex; flex-direction: column; gap: 4px;';

  if (label) {
    const labelEl = api.createElement('label');
    labelEl.textContent = label;
    labelEl.style.cssText = 'font-weight: 500; font-size: 0.875rem; color: var(--color-text);';
    wrapper.appendChild(labelEl);
  }

  const normalized = choices.map(opt =>
    typeof opt === 'string' ? { value: opt, label: opt } : opt
  );

  if (mode === 'editable' && onChange) {
    const select = api.createElement('select');
    select.style.cssText = 'padding: 8px; border: 1px solid var(--color-border); border-radius: var(--border-radius); font-size: 0.875rem; background: var(--color-bg-body); color: var(--color-text); cursor: pointer;';

    if (!value) {
      const blank = api.createElement('option');
      blank.value = '';
      blank.textContent = '(none)';
      select.appendChild(blank);
    }

    for (const opt of normalized) {
      const optEl = api.createElement('option');
      optEl.value = opt.value;
      optEl.textContent = opt.label;
      if (opt.value === value) optEl.selected = true;
      select.appendChild(optEl);
    }

    select.onchange = (e) => onChange(e.target.value);
    wrapper.appendChild(select);
  } else {
    const match = normalized.find(o => o.value === value);
    let displayText, extraStyle;
    if (match) {
      displayText = match.label;
      extraStyle = '';
    } else if (value) {
      displayText = value + ' (?)';
      extraStyle = ' color: var(--color-text-secondary);';
    } else {
      displayText = '(none)';
      extraStyle = ' color: var(--color-text-tertiary); font-style: italic;';
    }
    const span = api.createElement('span');
    span.textContent = displayText;
    span.style.cssText = 'padding: 8px; background: var(--color-bg-surface-alt); border-radius: var(--border-radius); font-size: 0.875rem;' + extraStyle;
    wrapper.appendChild(span);
  }

  return wrapper;
}
