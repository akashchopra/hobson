    "code": "(defn render [item api]\n  (def attachments (or (:attachments item) []))\n  (def default-view-id \"a1b2c3d4-e5f6-4a7b-8c9d-0e1f2a3b4c5d\")\n  [:div.sortable-list-view {:style \"display: flex; flex-direction: column; height: 100%; background: var(--color-bg-surface-alt);\"}\n\n    [:div.sortable-list-items {:style \"flex: 1; overflow-y: auto; padding-left: 2px; padding-top: 4px; padding-bottom: 10px; padding-right: 2px;\"\n                               :sortable {:handle \".drag-handle\"\n                                          :on-reorder (fn [from to]\n                                                        (reorder-attachments!\n                                                          from\n                                                          to))}}\n      (if\n        (seq attachments)\n        (for [child (seq attachments)]\n          (let [child-id (if (string? child) child (:id child))\n                view-id (or (get-in child [:view :type]) default-view-id)]\n            [:div.sortable-list-item {:data-item-id child-id\n                                      :data-parent-id (:id item)\n                                      :data-sort-key child-id\n                                      :style \"display: flex; align-items: center; margin-bottom: 4px;\"}\n              [:div.drag-handle {:style \"width: 44px; display: flex; align-items: center; justify-content: center; cursor: grab; user-select: none; flex-shrink: 0; color: var(--color-border-dark); touch-action: none;\"\n                                 :title \"Drag to reorder\"}\n                \"\u2261\"]\n              [:div {:style \"flex: 1; padding: 2px 4px; min-width: 0;\"}\n                [:render-child {:item child-id\n                                :view view-id\n                                :open-in (get-parent-id)}]]\n              [:div {:style \"width: 24px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;\"}\n\n                [:button {:style \"background: none; border: none; color: var(--color-border-dark); cursor: pointer; font-size: 1.125rem; padding: 4px;\"\n                          :title \"Remove from list\"\n                          :on-click (fn [e] (detach! child-id) (rerender!))}\n                  \"\u00d7\"]]]))\n        [:div {:style \"text-align: center; color: var(--color-border-dark); padding: 60px 20px; font-style: italic;\"}\n\n          \"This list is empty.\"])]])"
