    "description": [
      ":doc",
      [
        ":p",
        {
          "s": "Sortable lists provide drag-to-reorder functionality for item attachments displayed in a linear list (as opposed to the spatial canvas layout)."
        }
      ],
      [
        ":h2",
        {
          "s": "Concept"
        }
      ],
      [
        ":p",
        {
          "s": "While the "
        },
        [
          ":item-ref",
          {
            "s": "ef793c27-2d4b-4c99-b05a-2769db5bc5a9"
          },
          {
            "s": "spatial windowing system"
          }
        ],
        {
          "s": " arranges children on a 2D canvas, some contexts benefit from an ordered list:"
        }
      ],
      [
        ":ul",
        [
          ":li",
          [
            ":p",
            {
              "s": "Todo lists where order represents priority"
            }
          ]
        ],
        [
          ":li",
          [
            ":p",
            {
              "s": "Document outlines where order represents sequence"
            }
          ]
        ],
        [
          ":li",
          [
            ":p",
            {
              "s": "Playlists, reading lists, step-by-step instructions"
            }
          ]
        ]
      ],
      [
        ":p",
        {
          "s": "Sortable lists render attachments in array order with drag handles for reordering."
        }
      ],
      [
        ":h2",
        {
          "s": "Implementation"
        }
      ],
      [
        ":p",
        {
          "s": "The reorder operation modifies the parent item's "
        },
        [
          ":code",
          {
            "s": "attachments"
          }
        ],
        {
          "s": " array:"
        }
      ],
      [
        ":ol",
        [
          ":li",
          [
            ":p",
            {
              "s": "User drags an item to a new position"
            }
          ]
        ],
        [
          ":li",
          [
            ":p",
            {
              "s": "The attachment is removed from its current index"
            }
          ]
        ],
        [
          ":li",
          [
            ":p",
            {
              "s": "Inserted at the target index"
            }
          ]
        ],
        [
          ":li",
          [
            ":p",
            {
              "s": "Parent item saved with "
            },
            [
              ":code",
              {
                "s": "api.update()"
              }
            ],
            {
              "s": " to reflect new order"
            }
          ]
        ]
      ],
      [
        ":p",
        {
          "s": "The "
        },
        [
          ":code",
          {
            "s": "attachments"
          }
        ],
        {
          "s": " array is ordered \u2014 array position determines display order."
        }
      ],
      [
        ":h2",
        {
          "s": "Drag Interaction"
        }
      ],
      [
        ":ul",
        [
          ":li",
          [
            ":p",
            {
              "s": "Drag handle (grip icon) on each list item"
            }
          ]
        ],
        [
          ":li",
          [
            ":p",
            {
              "s": "Visual feedback: dragged item lifts, gap appears at drop target"
            }
          ]
        ],
        [
          ":li",
          [
            ":p",
            {
              "s": "Drop saves the new order immediately"
            }
          ]
        ],
        [
          ":li",
          [
            ":p",
            {
              "s": "Uses "
            },
            [
              ":item-ref",
              {
                "s": "c0c0c0c0-0010-0000-0000-000000000000"
              },
              {
                "s": "silent updates"
              }
            ],
            {
              "s": " during drag for smooth interaction"
            }
          ]
        ]
      ],
      [
        ":h2",
        {
          "s": "See Also"
        }
      ],
