export async function render(value, options, api) {
  const { label } = options;
  const attachments = value || [];

  const wrapper = api.createElement('div', { className: 'field-attachments' });
  wrapper.style.cssText = 'display: flex; flex-direction: column; gap: 4px;';

  if (label) {
    const labelEl = api.createElement('div');
    labelEl.textContent = label;
    labelEl.style.cssText = 'font-weight: 500; font-size: 0.875rem; color: var(--color-text); margin-bottom: 4px;';
    wrapper.appendChild(labelEl);
  }

  for (const att of attachments) {
    const id = att.id;
    let item, typeItem;
    try { item = await api.get(id); } catch { item = null; }
    if (item?.type) {
      try { typeItem = await api.get(item.type); } catch { typeItem = null; }
    }

    const row = api.createElement('div');
    row.style.cssText = 'display: flex; align-items: baseline; gap: 6px; padding: 3px 0; border-radius: var(--border-radius);';

    if (item) {
      row.style.cursor = 'pointer';
      row.addEventListener('click', (e) => api.openItem(e, { id }));

      const nameEl = api.createElement('span');
      nameEl.textContent = item.name || id.slice(0, 8);
      nameEl.style.cssText = 'color: var(--color-link, #2563eb); font-size: 0.8125rem;';
      row.appendChild(nameEl);

      if (typeItem?.name) {
        const typeEl = api.createElement('span');
        typeEl.textContent = typeItem.name;
        typeEl.style.cssText = 'color: var(--color-border-dark); font-size: 0.6875rem;';
        row.appendChild(typeEl);
      }
    } else {
      const missingEl = api.createElement('span');
      missingEl.textContent = `[deleted: ${id.slice(0, 13)}]`;
      missingEl.style.cssText = 'color: var(--color-border-dark); font-style: italic; font-size: 0.8125rem;';
      row.appendChild(missingEl);
    }

    wrapper.appendChild(row);
  }

  return wrapper;
}
