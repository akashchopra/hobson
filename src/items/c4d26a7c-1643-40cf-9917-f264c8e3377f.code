;;; --- JavaScript ---
// reminder-scheduler — JS boot shim
// Loads and evaluates this item's Hob scheduling logic at boot time.
// Also watches item:updated to reactively re-schedule edited reminders.
//
// evalSchedule is the single source of truth for "what time does this
// reminder fire next?" — used by schedule-one! (in Hob) and the reminder
// view. It reuses the scheduler's own interpreter, so scheduling helpers
// like (every :day 21 30) defined in our .hob are in scope.
//
// scheduleOneFrom(item, baseTime) is used by the "Done" button to schedule
// the next occurrence after a reminder's most recently scheduled time,
// even when that time is now in the past.

const SELF_ID = 'c4d26a7c-1643-40cf-9917-f264c8e3377f';
const REMINDER_TYPE = '0a41387e-78a9-4722-ab18-92aa14799385';
let _hob = null;
let _interp = null;
let _scheduleOne = null;
let _snoozeOne = null;
const _lastHob = new Map();

export async function onKernelBootComplete({ safeMode }, api) {
  if (safeMode) return;
  _hob = await api.require('hob-interpreter');
  _interp = _hob.createInterpreter(api);
  await _interp.macrosReady;
  const self = await api.get(SELF_ID);
  if (!self?.content?.hob) return;
  for (const ast of self.content.hob) {
    await _interp.evaluate(ast);
  }
  _scheduleOne = await _interp.eval('schedule-one!');
  _snoozeOne = await _interp.eval('snooze!');
  await checkExactAlarmPermission(api);
  await ensureReminderChannel();
  await _interp.eval('(boot-scan!)');
  try {
    const items = await api.getAll();
    for (const item of items) {
      if (item.type === REMINDER_TYPE) {
        _lastHob.set(item.id, JSON.stringify(item.content?.schedule ?? []));
      }
    }
  } catch (_) {}
}

export async function onItemUpdated({ item }, api) {
  if (!_scheduleOne || !item || item.type !== REMINDER_TYPE) return;
  // Skip re-schedule when only content.scheduledAt changed (written by schedule-one! itself).
  const hobKey = JSON.stringify(item.content?.schedule ?? []);
  if (_lastHob.get(item.id) === hobKey) return;
  _lastHob.set(item.id, hobKey);
  await _scheduleOne(item);
}

// Evaluate a reminder's schedule expression, returning the next-fire
// timestamp (ms since epoch) or null. If baseTime is provided, sets
// eval-base-time before evaluation so (every ...) uses it as the
// reference point instead of (now). Reentrant-safe: may be called
// from within Hob code running in _interp.
export async function evalSchedule(item, baseTime) {
  if (!_interp || !_hob) return null;
  const ast = item?.content?.schedule;
  if (!ast || ast.length === 0) return null;
  try {
    if (baseTime != null) {
      await _interp.eval(`(reset! eval-base-time ${baseTime})`);
    }
    const source = _hob.prettyPrintAll(ast);
    const result = await _interp.eval(source);
    return typeof result === 'number' ? result : null;
  } catch (e) {
    return null;
  } finally {
    if (baseTime != null) {
      await _interp.eval('(reset! eval-base-time nil)');
    }
  }
}

// Snooze a reminder for durationMs milliseconds, capped at its next scheduled time.
export async function snooze(item, durationMs) {
  if (!_snoozeOne) return;
  await _snoozeOne(item, durationMs);
}

// Returns the currently scheduled OS alarm timestamp for a reminder, or null.
export async function getScheduledAt(itemId) {
  if (!_interp) return null;
  try {
    const result = await _interp.eval(`(get (deref scheduled-at-map) "${itemId}")`);
    return typeof result === 'number' ? result : null;
  } catch (e) {
    return null;
  }
}

// Schedules the next occurrence of a recurring reminder, using baseTime
// as the reference for the schedule expression. If baseTime is in the
// past, advances forward until a future slot is found — handles "Done"
// tapped after the alarm already fired. Used by the "Done" button.
export async function scheduleOneFrom(item, baseTime) {
  if (!_interp || !_scheduleOne) return;
  let base = baseTime;
  const now = Date.now();
  // Advance base one recurrence step at a time until we find a future slot.
  // Bounded to 10 iterations as a guard against expression bugs. If iterations
  // are exhausted with base still in the past, fall back to now so schedule-one!
  // finds the next occurrence from the present rather than silently dropping the alarm.
  let iter = 0;
  while (base != null && base <= now && iter++ < 10) {
    const next = await evalSchedule(item, base);
    if (next == null || next > now) break;
    base = next;
  }
  if (base != null && base <= now) base = null;
  try {
    if (base != null) {
      await _interp.eval(`(reset! eval-base-time ${base})`);
    }
    await _scheduleOne(item);
  } finally {
    await _interp.eval('(reset! eval-base-time nil)');
  }
}

async function ensureReminderChannel() {
  try {
    const notif = window.__TAURI__?.notification;
    if (!notif?.createChannel) return;
    await notif.createChannel({
      id: 'reminders',
      name: 'Reminders',
      importance: 4,
      vibration: true,
    });
  } catch (e) {
    console.error('[reminder-scheduler] createChannel failed:', e);
  }
}

// Checks whether exact alarms are available on Android 12+.
// If not, opens the system settings screen so the user can grant
// SCHEDULE_EXACT_ALARM — needed for reminders to fire on time.
// Only prompts if at least one reminder with an active schedule exists.
async function checkExactAlarmPermission(api) {
  try {
    const notif = window.__TAURI__?.notification;
    if (!notif?.canScheduleExactAlarms) return;
    const { value } = await notif.canScheduleExactAlarms();
    if (value) return;
    const items = await api.getAll();
    const hasScheduled = items.some(
      it => it.type === REMINDER_TYPE && it.content?.schedule?.length > 0
    );
    if (!hasScheduled) return;
    await notif.requestScheduleExactAlarm();
  } catch (_) {}
}









;;; --- Hob ---
(def doc (dom-get (hiccup->dom [:div]) :ownerDocument))

(def win (dom-get doc :defaultView))

(def REMINDER_TYPE "0a41387e-78a9-4722-ab18-92aa14799385")

(def lib (require "reminder-lib"))

(def eval-base-time (get lib :eval-base-time))

(def notif-id-for (get lib :notif-id-for))

(def scheduled-at-map (atom {}))

(def notif-id-to-item-id (atom {}))

(defn schedule-one! [reminder]
  (let [id (get reminder :id)
        nid (notif-id-for id)
        next-time (eval-all (get-in reminder [:content :schedule]) lib)
        at (when (and (number? next-time) (> next-time (now))) next-time)]
    (try
      (when-let [tauri (dom-get win :__TAURI__)]
        (when-let [notif (dom-get tauri :notification)] (.cancel notif [nid])))
      (catch e nil))
    (swap! scheduled-at-map dissoc id)
    (swap! notif-id-to-item-id dissoc nid)
    (when
      at
      (let [title (or
                    (get-in reminder [:content :title])
                    (get reminder :name)
                    "Reminder")
]
        (when
          (.contains
            (dom-get (dom-get doc :documentElement) :classList)
            "env-mobile")
          (when-let [tauri (dom-get win :__TAURI__)]
            (when-let [notif (dom-get tauri :notification)]
              (.batch
                notif
                [{:id nid
                   :title title
                   :body ""
                   :channelId "reminders"
                   :schedule {:at {:date (.toISOString (js/Date. at))
                                   :repeating false
                                   :allowWhileIdle true}}
}
]))))
        (swap! scheduled-at-map assoc id at)
        (swap! notif-id-to-item-id assoc nid id)))
    (set-item! (assoc-in (get-item id) [:content :scheduledAt] at))))

(defn snooze! [reminder duration-ms]
  (let [id (get reminder :id)
        nid (notif-id-for id)
        next-scheduled (eval-all (get-in reminder [:content :schedule]) lib)
        snooze-at (let [t (+ (now) duration-ms)]
                    (if
                      (and
                        (number? next-scheduled)
                        (> next-scheduled (now))
                        (>= t next-scheduled))
                      next-scheduled
                      t))
        title (or
                (get-in reminder [:content :title])
                (get reminder :name)
                "Reminder")]
    (try
      (when-let [tauri (dom-get win :__TAURI__)]
        (when-let [notif (dom-get tauri :notification)] (.cancel notif [nid])))
      (catch e nil))
    (swap! scheduled-at-map dissoc id)
    (swap! notif-id-to-item-id dissoc nid)
    (when
      (> snooze-at (now))
      (when
        (.contains
          (dom-get (dom-get doc :documentElement) :classList)
          "env-mobile")
        (when-let [tauri (dom-get win :__TAURI__)]
          (when-let [notif (dom-get tauri :notification)]
            (.batch
              notif
              [{:id nid
                 :title title
                 :body ""
                 :channelId "reminders"
                 :schedule {:at {:date (.toISOString (js/Date. snooze-at))
                                 :repeating false
                                 :allowWhileIdle true}}
}
]))))
      (swap! scheduled-at-map assoc id snooze-at)
      (swap! notif-id-to-item-id assoc nid id))
    (set-item! (assoc-in (get-item id) [:content :scheduledAt] snooze-at))))

(defn cancel-one! [id]
  (let [nid (notif-id-for id)]
    (try
      (when-let [tauri (dom-get win :__TAURI__)]
        (when-let [notif (dom-get tauri :notification)] (.cancel notif [nid])))
      (catch e nil))
    (swap! scheduled-at-map dissoc id)
    (swap! notif-id-to-item-id dissoc nid)))

(defn boot-scan! []
  (let [all (get-all)
        reminders (filter (fn [item] (= (get item :type) REMINDER_TYPE)) all)]
    (when-let [tauri (dom-get win :__TAURI__)]
      (when-let [notif (dom-get tauri :notification)]
        (let [pending-list (try (.pending notif) (catch e []))
              pending-map (reduce
                            (fn [m p] (assoc m (dom-get p :id) p))
                            {}
                            (or pending-list []))]
          (doseq [r reminders]
            (let [id (get r :id) nid (notif-id-for id) p (get pending-map nid)]
              (swap! notif-id-to-item-id assoc nid id)
              (when
                p
                (let [sched (dom-get p :schedule)
                      at (when sched (dom-get sched :at))
                      date-str (when at (dom-get at :date))
                      ts (when date-str (.getTime (js/Date. date-str)))]
                  (when (number? ts) (swap! scheduled-at-map assoc id ts)))))))
        (when
          (dom-get notif :onAction)
          (try
            (.onAction
              notif
              (fn [action]
                (let [nid (dom-get action :id)
                      reminder-id (when
                                    nid
                                    (get (deref notif-id-to-item-id) nid))]
                  (when
                    reminder-id
                    (let [kernel (dom-get win :kernel)
                          vp-mgr (when
                                   kernel
                                   (.getCached
                                     (dom-get kernel :moduleSystem)
                                     "viewport-manager"))]
                      (if
                        vp-mgr
                        (.navigate vp-mgr reminder-id)
                        (dom-set!
                          (dom-get win :location)
                          :search
                          (str "?root=" reminder-id))))))))
            (catch e nil)))))
    (.log
      (dom-get win :console)
      (str "[reminder-scheduler] Scanned " (count reminders) " reminder(s)"))))