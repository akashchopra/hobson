{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "mobile",
  "description": "HTTP fetch capability for mobile (iOS/Android)",
  "windows": ["main"],
  "permissions": [
    "http:default",
    {"identifier": "http:allow-fetch", "allow": [{"url": "https://**"}]},
    {"identifier": "fs:allow-write-file", "allow": [{"path": "$APPCACHE/**"}]},
    "opener:default",
    {"identifier": "opener:allow-open-path", "allow": [{"path": "$APPCACHE/**"}]}
  ]
}
